<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<!doctype html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><c:out value="${title}"/> · 부조뱅크 SCM</title><script src="${pageContext.request.contextPath}/assets/theme.js?v=1"></script><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/app.css"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/theme.css?v=1"></head><body>
<div class="sidebar-scrim" data-close-menu></div><aside class="sidebar" id="navigation"><a class="brand" href="${pageContext.request.contextPath}/app/${storeMode ? 'catalog' : 'dashboard'}"><span class="brand-mark">B</span><span>부조뱅크 <small>SCM</small></span></a><div class="workspace"><span class="workspace-icon">▦</span><div><strong><c:out value="${storeMode ? actor.store_name : '통합 운영 관리'}"/></strong><small>${storeMode ? '매장 발주 시스템' : 'ADMIN WORKSPACE'}</small></div><span class="online-dot"></span></div><nav aria-label="주 메뉴"><c:set var="lastGroup" value=""/><c:forEach items="${pages}" var="item"><c:if test="${item.key != 'edit' && (item.key != 'admins' || superuser) && item.key != 'detail' && item.key != 'product-form' && (storeMode ? (item.key == 'catalog' || item.key == 'history' || item.key == 'password') : (item.key != 'catalog' && item.key != 'history'))}"><c:if test="${lastGroup != item.value[2]}"><div class="nav-group"><c:out value="${item.value[2]}"/></div><c:set var="lastGroup" value="${item.value[2]}"/></c:if><a class="nav-link ${page == item.key ? 'active' : ''}" href="${pageContext.request.contextPath}/app/${item.key}" ${page == item.key ? 'aria-current="page"' : ''}><span class="nav-icon">${item.key == 'dashboard' ? '▦' : item.key == 'reports' ? '▥' : item.key == 'products' ? '◇' : '▫'}</span><c:out value="${item.value[0]}"/></a></c:if></c:forEach></nav><div class="sidebar-bottom"><div class="help-box"><strong>도움이 필요하신가요?</strong><p>시스템 이용은 관리자에게 문의하세요.</p></div><small>BUJO BANK SCM <span>v1.0</span></small></div></aside>
<div class="app-shell"><header class="topbar"><div class="breadcrumb"><button class="menu-toggle" aria-label="메뉴 열기" aria-controls="navigation" aria-expanded="false">☰</button><span>워크스페이스</span><span>/</span><strong><c:out value="${title}"/></strong></div><div class="account"><button type="button" class="button theme-toggle" data-theme-toggle aria-pressed="false">다크 모드</button><span class="demo-badge">${storeMode ? (canOrder ? '발주 가능' : '조회 전용') : '관리자'}</span><span class="avatar">${storeMode ? '강' : '관'}</span><span class="account-name"><c:out value="${actor.name}"/><small><c:out value="${storeMode ? actor.store_name : '통합 운영'}"/></small></span><form action="${pageContext.request.contextPath}/app/logout" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><button class="text-button">로그아웃</button></form></div></header>
<main id="main"><div class="page-heading"><div><div class="eyebrow">BUJO BANK · ${storeMode ? 'STORE' : 'WORKSPACE'}</div><h1><c:out value="${title}"/></h1><p><c:out value="${subtitle}"/></p></div><span class="date-chip">◷ ${today}</span></div><c:if test="${not empty flash}"><div class="notice success" role="status"><c:out value="${flash}"/></div></c:if>
<c:choose><c:when test="${page == 'dashboard' || page == 'reports'}"><%@ include file="screens/dashboard.jspf" %></c:when><c:when test="${page == 'catalog'}"><%@ include file="screens/catalog.jspf" %></c:when><c:when test="${page == 'product-form' || page == 'edit' || page == 'password'}"><%@ include file="screens/product-form.jspf" %></c:when><c:when test="${page == 'detail'}"><%@ include file="screens/detail.jspf" %></c:when><c:otherwise><%@ include file="screens/list.jspf" %></c:otherwise></c:choose>
<footer class="page-footer">© 2026 부조뱅크 SCM<span>매장의 일상을 더 편리하게.</span></footer></main></div>
<dialog id="edit-dialog"><form method="dialog" class="dialog-header"><h2 id="dialog-title">정보 등록</h2><button aria-label="닫기" class="icon-button">×</button></form><form id="edit-form" class="dialog-body" method="post" action="${pageContext.request.contextPath}/app/save"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="requestToken" value="${requestToken}"><input type="hidden" name="action" value="order"><div id="dialog-fields"></div><p class="muted">발주 후 수정은 불가합니다. 서버에서 확인한 매장별 단가로 발주가 저장됩니다.</p><div class="dialog-actions"><button type="button" class="button" data-close-dialog>취소</button><button class="button primary">발주 확정</button></div></form></dialog><div id="toast" role="status" aria-live="polite"></div><script src="${pageContext.request.contextPath}/assets/app.js"></script></body></html>
