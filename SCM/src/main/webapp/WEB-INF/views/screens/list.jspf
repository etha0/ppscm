<%@ page pageEncoding="UTF-8" %>
<c:set var="productList" value="${page == 'products' || page == 'prices' || page == 'inventory'}"/><c:set var="orderList" value="${page == 'orders' || page == 'shipments' || page == 'history'}"/>
<section class="panel"><div class="panel-heading"><div><h2><c:out value="${title}"/> 목록 <span class="count">${productList ? fn:length(products) : orderList ? fn:length(orders) : fn:length(rows)}</span></h2><p>검색과 필터로 필요한 정보를 확인하세요.</p></div><div class="actions"><button class="button" data-export>↓ CSV 다운로드</button><c:choose><c:when test="${page == 'products'}"><a class="button" href="${pageContext.request.contextPath}/app/export-products">엑셀 다운로드</a><a class="button" href="${pageContext.request.contextPath}/app/edit?action=import">엑셀 업로드</a><a class="button primary" href="${pageContext.request.contextPath}/app/product-form">＋ 상품 등록</a></c:when><c:when test="${page == 'history'}"><c:if test="${canOrder}"><a class="button primary" href="${pageContext.request.contextPath}/app/catalog">＋ 상품 발주</a></c:if></c:when><c:when test="${page == 'prices'}"><a class="button primary" href="${pageContext.request.contextPath}/app/edit?action=price">가격 일괄 적용</a></c:when><c:when test="${page == 'receipts'}"><a class="button primary" href="${pageContext.request.contextPath}/app/edit?action=receipt">＋ 입고 등록</a></c:when><c:when test="${not empty editAction}"><a class="button primary" href="${pageContext.request.contextPath}/app/edit?action=${editAction}">＋ ${page == 'categories' ? '카테고리 등록' : page == 'suppliers' ? '공급업체 등록' : '신규 등록'}</a></c:when></c:choose></div></div>
<c:if test="${page == 'prices'}"><form class="filter-bar" method="get"><label>가격 조회 매장<select name="storeId"><option value="">기준 공급가</option><c:forEach items="${stores}" var="s"><option value="${s.id}" ${selectedStore == s.id ? 'selected' : ''}><c:out value="${s.name}"/></option></c:forEach></select></label><button class="button primary">조회</button></form></c:if>
<div class="filter-bar"><label class="search-label">검색<input type="search" id="table-search" placeholder="${page == 'categories' ? '카테고리명 검색' : page == 'suppliers' ? '공급업체명, 담당자 또는 연락처 검색' : page == 'receipts' ? '상품명, 공급업체명 또는 메모 검색' : '상품명, 매장명 또는 번호 검색'}"></label><label>필터<select id="table-filter" data-filter-kind="${productList ? 'category' : 'text'}"><option value="">전체</option><c:choose><c:when test="${productList}"><c:forEach items="${categories}" var="cat"><option value="${cat.id}"><c:out value="${cat.category}"/>${cat.active ? '' : ' (중지)'}</option></c:forEach></c:when><c:when test="${orderList}"><option>접수</option><option>부분 출고</option><option>출고 완료</option><option>취소</option></c:when><c:otherwise><option>사용 중</option><option>중지</option></c:otherwise></c:choose></select></label><button class="button" id="reset-filter">초기화</button></div>
<div class="table-scroll"><table id="data-table"><thead><tr><c:choose><c:when test="${productList}"><th>상품코드</th><th>상품 정보</th><th>카테고리</th><th>기준 공급가</th><th>${page == 'prices' ? '적용 단가' : '현재 재고'}</th><th>상태</th><th>관리</th></c:when><c:when test="${orderList}"><th>발주번호</th><th>매장</th><th>상품</th><th>발주 금액</th><th>접수일</th><th>상태</th><th>관리</th></c:when><c:otherwise><c:forEach items="${columns}" var="column"><th><c:out value="${column}"/></th></c:forEach><c:if test="${not empty editAction}"><th>관리</th></c:if></c:otherwise></c:choose></tr></thead><tbody>
<c:choose><c:when test="${productList}"><c:forEach items="${products}" var="p"><tr data-category-id="${p.category_id}"><td class="muted"><c:out value="${p.code}"/></td><td><div class="product-cell"><c:choose><c:when test="${not empty p.image_id}"><img class="product-thumb" src="${pageContext.request.contextPath}/app/image?id=${p.image_id}" alt=""></c:when><c:otherwise><div class="product-art small paper" aria-hidden="true"><span></span></div></c:otherwise></c:choose><div><strong><c:out value="${p.name}"/></strong><small><c:out value="${p.unit}"/></small></div></div></td><td><c:out value="${p.category}"/></td><td><fmt:formatNumber value="${p.price}" maxFractionDigits="2"/>원</td><td><c:choose><c:when test="${page == 'prices'}"><fmt:formatNumber value="${p.effective_price}" maxFractionDigits="2"/>원</c:when><c:otherwise>${p.stock}개</c:otherwise></c:choose></td><td><span class="status ${!p.active ? 'neutral' : p.stock <= p.safety_stock ? 'warning' : 'success'}">${!p.active ? '판매 중지' : p.stock <= p.safety_stock ? '재고 주의' : '정상'}</span></td><td><a class="text-link" href="${pageContext.request.contextPath}/app/${page == 'products' ? 'product-form' : 'edit'}?id=${p.id}${page == 'inventory' ? '&action=adjust' : page == 'prices' ? '&action=price' : ''}">${page == 'inventory' ? '재고 조정' : '수정'}</a><c:if test="${page == 'inventory'}"> <button type="button" class="button history-open" data-history-url="${pageContext.request.contextPath}/app/inventory-history?id=${p.id}" aria-haspopup="dialog">재고 이력</button></c:if></td></tr></c:forEach></c:when>
<c:when test="${orderList}"><c:forEach items="${orders}" var="o"><tr><td><a class="text-link" href="${pageContext.request.contextPath}/app/detail?id=${o.id}">PO-<fmt:formatNumber value="${o.id}" pattern="00000000"/></a></td><td><c:out value="${o.store_name}"/></td><td><c:out value="${o.first_product}"/> ${o.line_count > 1 ? '외' : ''} ${o.line_count > 1 ? o.line_count - 1 : ''}${o.line_count > 1 ? '건' : ''}</td><td><fmt:formatNumber value="${o.total}" maxFractionDigits="2"/>원</td><td><fmt:formatDate value="${o.created_at}" pattern="yyyy.MM.dd HH:mm"/></td><td><span class="status ${o.status == '부분 출고' ? 'warning' : o.status == '출고 완료' ? 'success' : ''}"><c:out value="${o.status}"/></span></td><td><a class="text-link" href="${pageContext.request.contextPath}/app/detail?id=${o.id}">상세 보기</a><c:if test="${page == 'shipments' && (o.status == '접수' || o.status == '부분 출고')}"> · <a class="text-link" href="${pageContext.request.contextPath}/app/edit?action=ship&id=${o.id}">출고</a></c:if></td></tr></c:forEach></c:when>
<c:otherwise><c:forEach items="${rows}" var="r"><tr><c:forEach items="${r.cells}" var="cell"><td><c:out value="${cell}"/></td></c:forEach><c:if test="${not empty editAction}"><td><a class="text-link" href="${pageContext.request.contextPath}/app/edit?action=${editAction}&id=${r.id}">상세 · 수정</a></td></c:if></tr></c:forEach></c:otherwise></c:choose>
</tbody></table><div class="empty-state" ${productList ? (not empty products ? 'hidden' : '') : orderList ? (not empty orders ? 'hidden' : '') : (not empty rows ? 'hidden' : '')}>조회된 데이터가 없습니다.</div></div><div class="table-footer"><span id="result-count">총 ${productList ? fn:length(products) : orderList ? fn:length(orders) : fn:length(rows)}건</span><span>검색은 현재 조회 목록에 적용됩니다.</span></div></section>
<c:if test="${page == 'inventory'}"><section class="panel secondary-panel"><div class="panel-heading"><h2>최근 재고 변동 이력</h2><span class="muted">최근 100건</span></div><div class="table-scroll"><table><thead><tr><th>처리일</th><th>상품</th><th>구분</th><th>변동</th><th>변경 전</th><th>변경 후</th><th>사유</th><th>담당자</th></tr></thead><tbody><c:forEach items="${events}" var="e"><tr><td><c:out value="${e.occurred_on}"/></td><td><c:out value="${e.product_name}"/></td><td><c:out value="${e.kind}"/></td><td>${e.delta}</td><td>${e.before_stock}</td><td>${e.after_stock}</td><td><c:out value="${e.note}"/></td><td><c:out value="${e.actor_name}"/></td></tr></c:forEach></tbody></table></div></section></c:if><c:if test="${page == 'inventory'}"><%@ include file="inventory-dialog.jspf" %></c:if>
